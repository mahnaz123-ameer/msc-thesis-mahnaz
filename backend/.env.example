# Copy this file to backend/.env and fill in your keys.
# backend/.env is ignored by git — never commit or share your keys.

# ChatGPT (OpenAI) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# The exact model to use. Write the same name in your thesis.
OPENAI_MODEL=gpt-4o

# Claude (Anthropic) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Gemini (Google) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
